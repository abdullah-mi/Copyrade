{
  "name": "@copyrade/desktop",
  "private": true,
  "version": "0.1.1",
  "type": "commonjs",
  "main": "dist-electron/main.js",
  "scripts": {
    "build": "tsc -b && vite build --configLoader native",
    "build:electron": "tsc -b tsconfig.electron.json",
    "make:windows": "npm run build && node ../../scripts/stage-desktop.mjs && electron-forge make .forge-stage --platform win32 --arch x64",
    "lint": "eslint .",
    "start": "npm run build && electron .",
    "test": "npm run build:electron && node --test --test-isolation=none dist-electron/*.test.js"
  },
  "dependencies": {
    "@copyrade/connection": "0.0.0",
    "@copyrade/transfer": "0.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "^44.4.3",
    "electron-winstaller": "^5.4.4",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2"
  }
}
